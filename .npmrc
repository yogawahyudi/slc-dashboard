legacy-peer-deps=true

# Supply-chain hardening: refuse to install package versions published less than
# `min-release-age` days ago. When a package is compromised and a malicious
# version is published, this cooldown gives the ecosystem time to detect and yank
# it before it can reach your install. Only affects NEW version resolution —
# existing package-lock.json entries are untouched, so `npm ci` is unaffected.
# Requires npm >= 11.10 (older npm silently ignores it; see devEngines in package.json).
#
# Need a fresh release sooner (e.g. an urgent security patch)? Add the package as
# `min-release-age-exclude[]=<pkg>`, or run a one-off `npm install <pkg> --min-release-age=0`.
min-release-age=7
